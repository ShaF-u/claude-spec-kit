# Core（context-reduction-core、ユーザースコープで登録済み）がこのプロジェクトを
# 対象に動くときの設定。Core は --config 無しならカレントディレクトリの
# aistudio.config を読み、project.root の既定は "."。
#
# このファイルが無いと context_retrieve は無予算・全ツール公開で動き、実測では
# Read/Grep より多くコンテキストを食う（context/bench/README.md）。
# 値は context/aistudio.config（本体側のチューニング済み設定）に合わせてある。

# 索引・検索から除外するパス。
# context/ はサブモジュール＝別リポジトリ（CoreのC++ソースと計測結果JSON 46件）で、
# このキット自身についての質問に対してはノイズにしかならない。
scan.extra_ignore_patterns=context/*,bench/results/*

# context_retrieve 1回の応答予算（トークン）。未設定(0)は無予算。
mcp.context_response_budget_tokens=8000

# tools/list に出すツールを絞る。未設定は全15個で、実測ではモデルが1つの質問を
# 複数ツールに分散してターン数が増え、かえって高くつく。
mcp.tools=context_retrieve,context_fetch,symbol_search,keyword_search

# 予算付き応答をJSONではなくテキストで返す（同じ内容で約1/3小さい）。
mcp.context_retrieve_format=text

# 同一セッションで既に送った項目は2回目以降スタブにする。
mcp.suppress_resent_content=true

# CLAUDE.md 全文を毎回混ぜるのを止める（Claude Code が起動時に読むので重複）。
backend.core.project_rules.files=
